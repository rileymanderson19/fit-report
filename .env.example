# -----------------------------------------------------------------------------
# Resend: https://shipfa.st/docs/features/emails
# -----------------------------------------------------------------------------
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# Database URI: https://shipfa.st/docs/features/database
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Stripe: https://shipfa.st/docs/features/payments
# -----------------------------------------------------------------------------
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Set to 'true' to require Stripe subscription for dashboard access
# Set to 'false' for concierge onboarding mode (admin invites)
NEXT_PUBLIC_STRIPE_GATING_ENABLED=false
NEXT_PUBLIC_CONCIERGE_ONBOARDING_ENABLED=true

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# 64 hex chars (32 bytes) for AES-256-GCM encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Secret for authenticating cron job requests
CRON_SECRET=